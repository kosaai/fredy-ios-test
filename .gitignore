# Xcode/user state and build output
.DS_Store
xcuserdata/
*.xcuserstate
DerivedData/
build/
*.xcarchive
*.ipa
__pycache__/
*.pyc

# Never publish runtime secrets, signing material, raw evidence or sessions
.env
.env.*
*.local.*
*.private.*
private/
secrets/
sessions/
cookies/
reports/
raw/
evidence/
logs/
*.log
*.har
*.sqlite
*.sqlite3
*.db
*.db-*
*.sql
*.dump
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
*.token
*cookie*.txt
*session*.json
config.local.*

# Graphify artifacts/caches are external, never public input or Git content
graphify-out/
.graphifyrc
.graphifyignore
.cache/
.venv/
