          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة غير متوفرة."
          }
        }
      }
    },
    "listings.session_expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Sign in again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلسة الدخول. سجّل الدخول مجددًا."
          }
        }
      }
    },
    "listings.sign_in": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول مجددًا"
          }
        }
      }
    },
    "listings.error_network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not connect. Check your connection and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الاتصال. تحقّق من الشبكة وحاول مجددًا."
          }
        }
      }
    },
    "listings.error_response": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server returned an unexpected response. Try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد الخادم استجابة غير متوقعة. حاول مجددًا."
          }
        }
      }
    },
    "listings.error_server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fredy is temporarily unavailable."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة Fredy غير متاحة مؤقتًا."
          }
        }
      }
    },
    "listings.error_access": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access was refused by the server or security gateway."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الخادم أو بوابة الحماية الوصول."
          }
        }
      }
