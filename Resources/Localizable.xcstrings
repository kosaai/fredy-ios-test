          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور"
          }
        }
      }
    },
    "login.submit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول"
          }
        }
      }
    },
    "login.submitting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تسجيل الدخول…"
          }
        }
      }
    },
    "login.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password is not saved. Your session is securely stored on this device and verified when the app opens."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُحفظ كلمة المرور. تُحفظ جلسة الدخول بأمان على هذا الجهاز، ويُتحقق منها عند فتح التطبيق."
          }
        }
      }
    },
    "login.success": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed in successfully"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل الدخول بنجاح"
          }
        }
      }
    },
    "login.success_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the server verified this session. No listings or jobs are fetched in this step."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق الخادم من هذه الجلسة. لا يتم جلب الإعلانات أو المهام في هذه المرحلة."
          }
        }
      }
    },
    "login.error_required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your username and password."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل اسم المستخدم وكلمة المرور."
          }
        }
      }
    },
    "login.error_credentials": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The username or password is incorrect. Re-enter your password to try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم أو كلمة المرور غير صحيح. أعد إدخال كلمة المرور للمحاولة مجددًا."
          }
        }
      }
    },
    "login.error_rate_limit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Wait before trying again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة. انتظر قبل المحاولة مجددًا."
          }
        }
      }
    },
    "login.error_access": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server or its security gateway refused access. Try again later."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الخادم أو بوابة الحماية الاتصال. حاول لاحقًا."
          }
        }
      }
    },
    "login.error_session": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The login session could not be verified. Sign in again."
