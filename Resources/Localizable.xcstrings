    },
    "listings.main_image": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Main listing photo"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة الرئيسية للإعلان"
          }
        }
      }
    },
