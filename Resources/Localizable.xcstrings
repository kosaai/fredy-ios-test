        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إعلانات إيجار في الصفحات المحمّلة. حمّل المزيد للمتابعة."
          }
        }
      }
    },
    "listings.untitled": {
      "localizations": {
        "en": {
