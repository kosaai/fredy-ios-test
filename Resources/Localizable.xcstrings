        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من جلسة الدخول. سجّل الدخول مجددًا."
          }
        }
      }
    },
    "login.error_server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the server is temporarily unavailable. Try again later."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة الخادم غير متاحة مؤقتًا. حاول لاحقًا."
